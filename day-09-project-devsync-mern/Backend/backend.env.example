# Copy to backend.env and fill in real values. Never commit backend.env.
# Generate each key with: openssl rand -hex 32
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://mongo:27017/devsync
CLIENT_URL=http://localhost:5173
ACCESS_KEY=replace-with-a-long-random-string
REFRESH_KEY=replace-with-another-long-random-string
